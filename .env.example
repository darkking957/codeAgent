# 复制为 .env 并填真实值：`cp .env.example .env`。
# .env 已被 .gitignore 屏蔽——这是「拉取后唯一需要手填的机密文件」。
# compose 在项目根自动加载 .env，注入 db / app / caddy 容器。

# provider 密钥（DeepSeek 的 Anthropic 端点 key 等）；供 config.yaml 的 ${ANTHROPIC_API_KEY} 解析。
ANTHROPIC_API_KEY=sk-在此填入

# Postgres 口令（机器内部用，建议纯 hex / 字母数字，避免 $ # 等特殊字符省去转义）。
# 生成：python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=在此填入
